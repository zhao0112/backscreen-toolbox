<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <!-- 标题行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="计时器"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tm_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="滑动设定时长"
                        android:textSize="12.5sp"
                        android:textColor="@color/ink3" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 时长滑块：唯一的设置入口 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="22dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/tm_big_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="25:00"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.04"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/tm_big_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="番茄钟"
                    android:textSize="13sp"
                    android:textColor="@color/ink3" />

                <com.local.backscreengame.DurationSlider
                    android:id="@+id/tm_slider"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="18dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1 分"
                        android:textSize="10.5sp"
                        android:textColor="@color/ink4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="时长"
                        android:textSize="10.5sp"
                        android:textColor="@color/ink3" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="2 小时"
                        android:textSize="10.5sp"
                        android:textColor="@color/ink4" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="横向拖动调时长 · 纵向拖动微调到秒"
                    android:textSize="11sp"
                    android:textColor="@color/ink4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tm_start"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_primary"
                        android:gravity="center"
                        android:text="开始"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_accent"
                        android:clickable="true" android:focusable="true" />

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/tm_reset"
                        android:layout_width="108dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_btn_ghost"
                        android:gravity="center"
                        android:text="重置"
                        android:textSize="15sp"
                        android:textColor="@color/ink2"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 其他计时器：极简列表 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="其他计时器"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.11"
                    android:textAllCaps="true"
                    android:textColor="@color/ink4" />

                <TextView
                    android:id="@+id/tm_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="+ 新建"
                    android:textSize="12sp"
                    android:textColor="@color/accent"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tm_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
