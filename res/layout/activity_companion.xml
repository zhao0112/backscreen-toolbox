<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/cp_root"
    android:background="@color/canvas">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <!-- 标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="陪伴"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="切到这个 tab，背屏就是它"
                    android:textSize="12.5sp"
                    android:textColor="@color/ink3" />
            </LinearLayout>

            <!-- 大预览：主角 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="现在的它"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.11"
                        android:textAllCaps="true"
                        android:textColor="@color/ink4" />

                    <TextView
                        android:id="@+id/cp_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="没在"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink3" />
                </LinearLayout>

                <com.local.backscreengame.DotView
                    android:id="@+id/cp_preview"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dots" />

                <TextView
                    android:id="@+id/cp_silent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="一直在你身边"
                    android:textSize="11.5sp"
                    android:textColor="@color/ink3" />
            </LinearLayout>

            <!-- 开关：主操作 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cp_switch_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开启陪伴"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="背屏一次只能显示一样东西，所以陪伴独占一个 tab"
                        android:textSize="12sp"
                        android:textColor="@color/ink3" />
                </LinearLayout>

                <com.local.backscreengame.ToggleSwitch
                    android:id="@+id/cp_power"
                    android:layout_width="46dp"
                    android:layout_height="27dp" />
            </LinearLayout>

            <!-- 它会做什么 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="它会做什么"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:textColor="@color/ink4" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="· 安静时只是有一颗很暗的呼吸点，不打扰你"
                    android:textSize="12.5sp"
                    android:textColor="@color/ink2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="· 收到通知只给你一个表情，不显示内容"
                    android:textSize="12.5sp"
                    android:textColor="@color/ink2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="· 副歌到了会亮一下，跟你一起听歌"
                    android:textSize="12.5sp"
                    android:textColor="@color/ink2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="· 你说话时它会看着你"
                    android:textSize="12.5sp"
                    android:textColor="@color/ink2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="· 深夜它自己睡，白天太久不理它会犯困"
                    android:textSize="12.5sp"
                    android:textColor="@color/ink2" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>